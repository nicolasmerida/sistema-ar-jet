generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model administrador {
  dni     String  @id @db.VarChar(20)
  usuario usuario @relation(fields: [dni], references: [dni], onDelete: Cascade, onUpdate: NoAction)
}

model aeropuerto {
  id_aeropuerto                   Int     @id @default(autoincrement())
  direccion                       String  @db.VarChar(200)
  ciudad                          String  @db.VarChar(100)
  pais                            String  @db.VarChar(100)
  vuelo_vuelo_destinoToaeropuerto vuelo[] @relation("vuelo_destinoToaeropuerto")
  vuelo_vuelo_origenToaeropuerto  vuelo[] @relation("vuelo_origenToaeropuerto")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model avion {
  id_avion          Int     @id @default(autoincrement())
  capacidad_primera Int
  capacidad_economy Int
  viaje             viaje[]
}

model cliente {
  dni     String  @id @db.VarChar(20)
  usuario usuario @relation(fields: [dni], references: [dni], onDelete: Cascade, onUpdate: NoAction)
}

model empleado {
  dni     String  @id @db.VarChar(20)
  usuario usuario @relation(fields: [dni], references: [dni], onDelete: Cascade, onUpdate: NoAction)
}

model estado {
  id_viaje     Int
  estado_viaje estado_viaje_t
  motivo       String?        @db.VarChar(255)
  viaje        viaje          @relation(fields: [id_viaje], references: [id_viaje], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_viaje, estado_viaje])
}

model pago {
  cod_compra    Int             @id @default(autoincrement())
  factura       String?         @unique @db.VarChar(50)
  tipo          tipo_pago_t
  estado_compra estado_compra_t @default(pendiente)
  pasaje        pasaje[]
  reserva       reserva?
}

model pasaje {
  id_pasaje                          Int      @id @default(autoincrement())
  id_viaje                           Int
  compra                             Int
  pasajero                           String   @db.VarChar(20)
  clase                              clase_t
  pago                               pago     @relation(fields: [compra], references: [cod_compra], onDelete: NoAction, onUpdate: NoAction)
  viaje                              viaje    @relation(fields: [id_viaje], references: [id_viaje], onDelete: NoAction, onUpdate: NoAction)
  pasajero_pasaje_pasajeroTopasajero pasajero @relation("pasaje_pasajeroTopasajero", fields: [pasajero], references: [dni], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_viaje, pasajero], map: "pasaje_unico_por_viaje")
  @@index([compra], map: "idx_pasaje_compra")
  @@index([pasajero], map: "idx_pasaje_pasajero")
}

model pasajero {
  dni                              String   @id @db.VarChar(20)
  nombre                           String   @db.VarChar(100)
  apellido                         String   @db.VarChar(100)
  pasaje_pasaje_pasajeroTopasajero pasaje[] @relation("pasaje_pasajeroTopasajero")
}

model reserva {
  cod_compra  Int     @id
  dni_usuario String  @db.VarChar(20)
  pago        pago    @relation(fields: [cod_compra], references: [cod_compra], onDelete: Cascade, onUpdate: NoAction)
  usuario     usuario @relation(fields: [dni_usuario], references: [dni], onDelete: NoAction, onUpdate: NoAction)

  @@index([dni_usuario], map: "idx_reserva_usuario")
}

model usuario {
  dni              String         @id @db.VarChar(20)
  nombre           String         @db.VarChar(100)
  apellido         String         @db.VarChar(100)
  contrasenia_hash String         @db.VarChar(255)
  administrador    administrador?
  cliente          cliente?
  empleado         empleado?
  reserva          reserva[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model viaje {
  id_viaje          Int            @id @default(autoincrement())
  id_vuelo          Int
  id_avion          Int
  fecha_partida     DateTime       @db.Timestamptz(6)
  fecha_llegada     DateTime       @db.Timestamptz(6)
  estado            estado_viaje_t @default(programado)
  historial_estados estado[]
  pasaje            pasaje[]
  avion             avion          @relation(fields: [id_avion], references: [id_avion], onDelete: NoAction, onUpdate: NoAction)
  vuelo             vuelo          @relation(fields: [id_vuelo], references: [id_vuelo], onDelete: NoAction, onUpdate: NoAction)

  @@index([fecha_partida], map: "idx_viaje_fecha_partida")
  @@index([id_vuelo], map: "idx_viaje_vuelo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vuelo {
  id_vuelo                             Int        @id @default(autoincrement())
  origen                               Int
  destino                              Int
  inicio_disp                          DateTime   @db.Date
  fin_disp                             DateTime   @db.Date
  precio_economy                       Decimal    @db.Decimal(10, 2)
  precio_primera                       Decimal    @db.Decimal(10, 2)
  viaje                                viaje[]
  aeropuerto_vuelo_destinoToaeropuerto aeropuerto @relation("vuelo_destinoToaeropuerto", fields: [destino], references: [id_aeropuerto], onDelete: NoAction, onUpdate: NoAction)
  aeropuerto_vuelo_origenToaeropuerto  aeropuerto @relation("vuelo_origenToaeropuerto", fields: [origen], references: [id_aeropuerto], onDelete: NoAction, onUpdate: NoAction)

  @@index([origen, destino], map: "idx_vuelo_origen_destino")
}

enum clase_t {
  economy
  primera
}

enum estado_compra_t {
  pendiente
  pagado
  cancelado
  reembolsado
}

enum estado_viaje_t {
  programado
  en_curso
  demorado
  cancelado
  finalizado
}

enum tipo_pago_t {
  tarjeta_credito
  tarjeta_debito
  transferencia
  efectivo
}
